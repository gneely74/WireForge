{
  "name": "wireforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wireforge/api dev & pnpm --filter @wireforge/web dev",
    "dev:api": "pnpm --filter @wireforge/api dev",
    "dev:web": "pnpm --filter @wireforge/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @wireforge/api start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rimraf dist node_modules",
    "deploy": "ssh -o BatchMode=yes -o ConnectTimeout=15 gneely@192.168.74.102 'set -e; cd /docker/wireforge && git fetch origin && git pull --ff-only origin main && docker compose up -d --build && sleep 3 && docker compose ps'"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7",
    "rimraf": "^6.0.1"
  }
}
